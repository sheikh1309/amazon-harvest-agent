# ---------------------------------------------------------------- required

# Every agent in the run goes through openrouter. Without this the run exits 2
# before the browser starts, rather than 401-ing inside a subagent minutes later.
OPENROUTER_API_KEY=

# Products and generated pages are written to the dealhub postgres, and each run is
# recorded in `harvest_runs`. Leave unset to scrape without saving anything.
# Use the neon POOLED endpoint (-pooler in the host) when running workers concurrently.
DATABASE_URL=

# ---------------------------------------------------------------- models

# An openrouter slug, NOT a bare model name — deepagents infers the provider from the
# string and does not recognise these, which is why lib/model.ts hands out instances.
# Deliberately not MODEL_NAME: that key already exists pointing at a different model.
AGENT_MODEL=anthropic/claude-sonnet-4.5

# Comma-separated openrouter fallbacks, tried in order when the primary is down.
# EMPTY IS THE SAFE SETTING. Whatever answers here writes the page copy that gets
# committed to `pages` and served publicly, so a fallback to a weaker model converts
# an outage you would notice into bad content you would not.
# AGENT_FALLBACK_MODELS=anthropic/claude-haiku-4.5

MODEL_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=16000

# ---------------------------------------------------------------- limits

# Hard ceilings for one harvest. 0 disables either. A model that loses the thread
# will loop until the recursion limit, and across a 660k-keyword backlog that is a
# bill rather than an incident.
TOKEN_BUDGET=2000000
RUN_TIMEOUT_MINUTES=30

# How long a claimed-but-unfinished keyword stays claimed. A worker killed mid-run
# cannot release its own claim, so claims expire instead of needing a janitor.
# Keep this comfortably above RUN_TIMEOUT_MINUTES or a slow run loses its keyword.
KEYWORD_CLAIM_TIMEOUT_MINUTES=60

# ---------------------------------------------------------------- scraping

# >6 parallel contexts from one IP gets you captcha'd.
CONCURRENCY=6
AMAZON_ZIP=10001

# Amazon pins the delivery COUNTRY by request IP; the zip above only moves you within
# it. From a non-US IP every price written to products.price is localised while looking
# exactly like a US figure. Set a US proxy in production.
# PROXY_SERVER=http://user:pass@us-proxy.example.com:8080

# Abort the run rather than publish non-US prices. Off by default so a local run works;
# turn it on wherever the price field has to be trustworthy.
REQUIRE_US_PRICING=0

# HEADFUL=1

# ---------------------------------------------------------------- run size

MAX_PAGES=3
CANDIDATE_COUNT=30
FINAL_COUNT=10
MIN_RATING=4.0
MIN_REVIEWS=100

# ---------------------------------------------------------------- output

AFFILIATE_TAG=best10deals-20
SITE_DOMAIN=best10deals.com

# Each run works inside <WORKSPACE>/<keyword-slug>/, so parallel workers never touch
# each other's files. Cleared once the run is recorded in harvest_runs.
WORKSPACE=workspace
OUTPUT_DIR=output
# KEEP_WORKSPACE=1

# text (default) or json — one structured object per line, for a log collector.
LOG_FORMAT=text
LOG_LEVEL=info

# ---------------------------------------------------------------- schema

# The schema lives in ./migrations. `pnpm run migrate` applies anything pending,
# writing the same `_sqlx_migrations` ledger sqlx-cli does — so this and sqlx-cli
# stay interchangeable against the same database, and either tool can go first.
# That compatibility is why there is a migrator here rather than a migration package:
# every one of those keeps its own ledger table and would not see these ten as applied.
MIGRATIONS_DIR=migrations

# Store the full harvest payload in harvest_runs.output alongside the metrics.
#
# OFF because the instance is full: `pnpm run db:size` reports 501MB of a 512MB Neon
# tier, and a ten-product payload is 60-120KB. Status, error and metrics are recorded
# either way and cost a few hundred bytes. Turn this on for a specific investigation,
# or once the project moves to a larger plan.
RECORD_RUN_PAYLOAD=0

# Run every page statement against the live schema, then roll back. For iterating on
# the writer's prompt without leaving pages behind.
PAGE_DRY_RUN=0

# Only used for an ad-hoc CLI keyword that is not a row in `keywords`; products.category_id
# is NOT NULL and there is nothing to infer it from.
# CATEGORY_ID=
