# required
ANTHROPIC_API_KEY=

# models — NOT MODEL_NAME, which is already used for a non-anthropic model
AGENT_MODEL=claude-opus-5
AGENT_FAST_MODEL=claude-haiku-4-5

# scraping
CONCURRENCY=6
AMAZON_ZIP=10001
# amazon pins the delivery country by IP; use a US proxy for US prices
# PROXY_SERVER=http://user:pass@us-proxy.example.com:8080
# HEADFUL=1

# run size
MAX_PAGES=3
CANDIDATE_COUNT=30
FINAL_COUNT=10
MIN_RATING=4.0
MIN_REVIEWS=100

# output
AFFILIATE_TAG=best10deals-20
WORKSPACE=workspace
