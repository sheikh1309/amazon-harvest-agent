{
  "name": "amazon-harvest-agent",
  "version": "1.0.0",
  "description": "Deep agent that harvests ranked amazon products, images and variant data into postgres as SEO pages",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "migrate": "tsx src/dev/migrate.ts",
    "check": "tsx src/dev/check-selectors.ts",
    "check:db": "tsx src/dev/check-db.ts",
    "check:writer": "tsx src/dev/check-writer.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "serve": "pnpm run build && node dist/index.js",
    "verify": "pnpm run typecheck && pnpm run test",
    "db:size": "tsx src/dev/db-size.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.23.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openrouter": "^0.4.8",
    "deepagents": "^1.12.1",
    "dotenv": "^17.4.2",
    "langchain": "^1.5.4",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
