{
  "name": "amazon-harvest-agent",
  "version": "1.0.0",
  "description": "Deep agent that harvests ranked amazon products, images and variant data to disk",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "check": "tsx src/dev/check-selectors.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "serve": "pnpm run build && node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "deepagents": "^1.12.1",
    "dotenv": "^17.4.2",
    "langchain": "^1.5.4",
    "zod": "^4.4.3"
  }
}
